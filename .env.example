# ---------- PostgreSQL ----------
POSTGRES_DB=adb_resolver
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Порт, на котором Postgres будет слушать на хост-машине.
# Внутри compose-сети приложение всегда ходит на postgres:5432.
POSTGRES_PORT=5432

# ---------- Nginx (SSL termination) ----------
HTTP_PORT=80
HTTPS_PORT=443
# Хост/IP, под который будет выпущен self-signed сертификат при первом запуске.
# Используется только для CN и SubjectAltName. Замените на реальный IP сервера.
SERVER_HOST=adb-server

# ---------- Spring Boot ----------
SERVER_PORT=8081
# Можно переопределить полностью. По умолчанию собирается из POSTGRES_*.
# DB_URL=jdbc:postgresql://postgres:5432/adb_resolver
# DB_USER=postgres
# DB_PASSWORD=postgres

# ---------- Telegram bot ----------
BOT_USERNAME=sync_auth_bot
BOT_TOKEN=8907866781:AAFJp0NVI1vsFGEtLYktfri74yAqDWKX0ew
# Список Telegram ID админов через запятую, например: 889144963,123456789
BOT_ADMINS=889144963
